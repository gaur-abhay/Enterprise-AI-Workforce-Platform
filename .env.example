# Copy to .env and fill in. .env is git-ignored — never commit real secrets.

# --- PostgreSQL + PGVector (docker compose service: postgres) ---
POSTGRES_USER=aiemployee
POSTGRES_PASSWORD=change_me
POSTGRES_DB=ai_employee
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Used by the app; keep in sync with the values above.
DATABASE_URL=postgresql+psycopg://aiemployee:change_me@localhost:5432/ai_employee
# Unprivileged role tenant sessions switch to so RLS applies; created by the first migration.
DB_APP_ROLE=ai_employee_app
# Database tests drop and recreate this database; the name must end in _test.
TEST_DATABASE_URL=postgresql+psycopg://aiemployee:change_me@localhost:5432/ai_employee_test

# --- Provider selection ---
# LLM_PROVIDER:       azure_openai | gemini
# EMBEDDING_PROVIDER: ollama | gemini
# Gemini has a free tier, which makes it the cheaper pair for local testing.
LLM_PROVIDER=azure_openai
EMBEDDING_PROVIDER=ollama

# Vector width, baked into the chunks table when the schema is first applied. It must match
# the active embedding model: nomic-embed-text and text-embedding-004 are both 768.
# Changing it against an existing table requires a migration, not just a restart.
EMBEDDING_DIM=768

# --- Ollama (docker compose service: ollama) — local embeddings ---
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text

# --- Azure OpenAI ---
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-10-21

# --- Google Gemini (https://aistudio.google.com/apikey) ---
GOOGLE_API_KEY=
GEMINI_CHAT_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
# Leave unset to use the model's native width. Only set it for models that support
# truncated output dimensions, and keep it equal to EMBEDDING_DIM.
# GEMINI_EMBEDDING_OUTPUT_DIM=768

# --- Azure Blob Storage (ingestion source) ---
# Only needed for `make ingest SOURCE=azure://...`. Pick one of the two auth styles.
# 1. Connection string — simplest locally, but it embeds the account key.
AZURE_STORAGE_CONNECTION_STRING=
# 2. Account URL — authenticates with Entra ID via DefaultAzureCredential: a managed
#    identity on Azure, the AZURE_TENANT_ID/AZURE_CLIENT_ID/AZURE_CLIENT_SECRET service
#    principal on any other server, or your local `az login`. The identity needs the
#    "Storage Blob Data Reader" role — Owner/Contributor alone returns 403 on the data plane.
AZURE_STORAGE_ACCOUNT_URL=
# Defaults used when the source is given as a bare `azure://`.
AZURE_STORAGE_CONTAINER=
AZURE_STORAGE_PREFIX=

# --- App ---
# Applies to the application's own loggers; third-party SDKs stay at WARNING so a DEBUG run
# is not buried in Azure and HTTP client traffic.
LOG_LEVEL=INFO
# text | json — json emits one object per line for a log shipper.
LOG_FORMAT=text